# --- vision-agent (AI Language Teacher) ---
#
# STREAM_API_KEY / STREAM_API_SECRET are REUSED from the Expo app's .env in the
# parent folder (../.env) automatically — you usually do NOT need to set them
# here. They are listed for reference / standalone runs.
#
# STREAM_API_KEY=...
# STREAM_API_SECRET=...

# OpenAI Realtime — the teacher's brain (speech-to-speech). Required.
# Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Which language the teacher helps the learner practise. The teacher always
# SPEAKS English and teaches this language through English. Default: Spanish.
TEACH_LANGUAGE=Spanish
