# Clerk — get this from https://dashboard.clerk.com/ → API keys → Publishable key
# Publishable keys are safe to expose in the client (they start with pk_).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Secret Key — SERVER ONLY (used by the Expo API routes to verify the
# logged-in user before minting a Stream token). Never prefix with EXPO_PUBLIC_;
# that would ship it to the device. Get it from the same Clerk dashboard page.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stream (GetStream) — https://dashboard.getstream.io/ → your app → keys
# The API key is safe to expose in the client (like a publishable key).
EXPO_PUBLIC_STREAM_API_KEY=xxxxxxxxxxxx
# The API secret is SERVER ONLY — used by the API routes to sign tokens and
# create calls. Never prefix it with EXPO_PUBLIC_.
STREAM_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL the device uses to reach the Expo API routes (the +api.ts handlers).
# Leave blank on web (relative fetch works). For a phone/emulator running a dev
# client, set this to your machine's LAN dev-server URL, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8081
EXPO_PUBLIC_API_URL=

# Vision Agent (AI teacher) server — SERVER ONLY. The Expo API routes
# (/api/agent/start|stop) proxy to the Python Vision Agent service started with
# `cd vision-agent && uv run agent.py serve`. Point this at that server.
#   VISION_AGENT_URL=http://localhost:8000
# Never prefix with EXPO_PUBLIC_ — the device must never reach the agent server
# directly. Without it the audio call still works; only the AI teacher is absent.
VISION_AGENT_URL=
# Optional bearer token if you put the Vision Agent server behind auth.
VISION_AGENT_API_KEY=
